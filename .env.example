# Copy to .env and fill in. NEVER commit .env.

# --- App ---
APP_NAME=Shortly
BASE_URL=http://localhost:5000
# Hostnames that must not be shortened (self-referencing check), comma-separated
BLOCKED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (docker-compose uses these too) ---
POSTGRES_USER=shortener
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shortener
DATABASE_URL=postgresql+psycopg2://shortener:change-me@localhost:5432/shortener

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
# Set to false to bypass Redis entirely (used to benchmark with/without cache)
CACHE_ENABLED=true
# Set to false to redirect without recording clicks (isolates redirect speed in benchmarks)
CLICK_TRACKING_ENABLED=true

# --- JWT (generate with: openssl rand -hex 32) ---
SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Links ---
SHORT_CODE_LENGTH=7

# --- Rate limiting ---
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ENABLED=true

# Number of reverse proxies in front of the app (0 = none). Needed so rate limits see real client IPs.
TRUSTED_PROXY_COUNT=0

# --- GeoIP (download GeoLite2-Country.mmdb from MaxMind; optional) ---
GEOIP_DB_PATH=data/GeoLite2-Country.mmdb

# --- Dashboard ---
API_URL=http://localhost:5000

# --- Docker only: gunicorn worker processes ---
WEB_CONCURRENCY=2

# --- Docker (docker compose) ---
# None of these are required: compose has development defaults for all of them.
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB above are used by the db container AND the api.
# Changing POSTGRES_PASSWORD after the first run needs:  docker compose down -v   (deletes the DB!)
API_PORT=5000
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
DASHBOARD_PORT=8501
